      {"pin": 7, "function": "P1S/P2S",   "net": "Net-(D4-K)",                 "role": "shared high rail / DS2712 VP1 sense rail"},
      {"pin": 8, "function": "P1G",       "net": "Net-(Q1-D)",                 "role": "A-side high-switch gate"}
